// Script: Attack and Hide
// Descripción: Ataca al objetivo y luego activa Hiding
// Autor: Claude
// Uso: Establece un objetivo primero con Target Last, luego ejecuta el script

// Atacar al último objetivo
attack last

// Esperar un momento para que el ataque se registre
pause 250

// Activar habilidad Hiding
useskill 'Hiding'

// Mensaje de confirmación
overhead 'Hiding activado!' 88
